# ==========================================
# PROVIDERS
# LLM: anthropic, openai, azure, vertex
# EMBEDDING: local, anthropic, openai, azure, vertex
# ==========================================
LLM_PROVIDER=
EMBEDDINGS_PROVIDER=

# ==========================================
# EMBEDDING MODELS
# ==========================================
LOCAL_EMBEDDING_MODEL=
ANTHROPIC_EMBEDDING_MODEL=
AZURE_EMBEDDING_MODEL=
OPENAI_EMBEDDING_MODEL=
VERTEX_EMBEDDING_MODEL=

# ==========================================
# LLM MODELS
# ==========================================
ANTHROPIC_MODEL=
AZURE_MODEL=
OPENAI_MODEL=
VERTEX_MODEL=

# ==========================================
# ANTHROPIC SETTINGS
# Anthropic has no native embeddings API, so the "anthropic" embeddings
# provider routes through Voyage AI (Anthropic's recommended provider).
# VOYAGE_API_KEY is only required when EMBEDDINGS_PROVIDER=anthropic.
# ==========================================
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ==========================================
# AZURE SETTINGS
# AZURE_API_VERSION is shared by the Azure LLM and Azure embeddings clients.
# ==========================================
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_API_VERSION=

# ==========================================
# OPENAI SETTINGS
# ==========================================
OPENAI_API_KEY=

# ==========================================
# VERTEX SETTINGS
# ==========================================
VERTEX_AI_LOCATION=
VERTEX_AI_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-key.json

# ==========================================
# APPLICATION TEXTS
# WELCOME_MESSAGE  - Greeting printed when the app starts.
# DEFAULT_QUESTION - Suggested question; also used as fallback when the user submits empty input.
# SYSTEM_PROMPT    - System prompt for the LLM. Must contain the "{context}" placeholder;
#                    if it doesn't, the retrieval context block is appended automatically.
# ==========================================
WELCOME_MESSAGE=
DEFAULT_QUESTION=
SYSTEM_PROMPT=
